#ifndef LIBRO_H
#define LIBRO_H

#include <string>
#include <iostream>
using namespace std;

struct Libro {
    string id; // Obligatorio para GenericService
    string titulo;
    string autor;
    int anioPublicacion;

    // Método obligatorio para GenericService
    void mostrar() const {
        cout << "ID: " << id << "\n";
        cout << "Título: " << titulo << "\n";
        cout << "Autor: " << autor << "\n";
        cout << "Año: " << anioPublicacion << "\n";
        cout << "---------------------------------\n";
    }
};

#include <iostream>
#include <vector>
#include "Generic_Service.h"
#include "Libro.h"

using namespace std;

int main() {
    vector<Libro> catalogoLibros;

    Libro l1 = {"L001", "Alicia en el pais de las maravillas", "Lewis Carroll", 1865};
    Libro l2 = {"L002", "Don Quijote de la Mancha", "Miguel de Cervantes", 1605};
    Libro l3 = {"L003", "Las Cronicas de Narnia", "C.S. Lewis", 1950};

    cout << "--- AGREGANDO LIBROS ---\n";
    GenericService<Libro>::agregar(catalogoLibros, l1);
    GenericService<Libro>::agregar(catalogoLibros, l2);
    GenericService<Libro>::agregar(catalogoLibros, l3);
    cout << "\n";

    cout << "--- MOSTRAR CATÁLOGO ---\n";
    GenericService<Libro>::mostrar(catalogoLibros);
    cout << "\n";

    cout << "--- BUSCAR LIBRO ---\n";
    GenericService<Libro>::buscar(catalogoLibros, "L002");
    cout << "\n";

    cout << "--- ELIMINAR LIBRO ---\n";
    GenericService<Libro>::eliminar(catalogoLibros, "L001");
    cout << "\n";

    cout << "--- CATÁLOGO ACTUALIZADO ---\n";
    GenericService<Libro>::mostrar(catalogoLibros);

    return 0;
}

#endif
